# Copy to infra/gcp/config.env (gitignored) and fill in. Every script sources it.
PROJECT_ID=craftstream-xxxxxx          # a NEW, dedicated project (billing enabled)
REGION=asia-south1                     # Cloud Run, buckets, Firestore, Transcoder, Eventarc
SERVICE=craftstream-api                # Cloud Run service name
WEB_ORIGINS=http://localhost:8080      # comma-separated origins allowed to upload/play (add the Firebase Hosting URL later)
RAW_RETENTION_DAYS=7                   # raw uploads are deleted after this many days (HLS output is kept)
