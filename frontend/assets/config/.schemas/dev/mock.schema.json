{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "assets/config/dev/mock.yml",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "latency_ms": {
      "type": "integer"
    },
    "chunk_delay_ms": {
      "type": "integer"
    },
    "processing_seconds": {
      "type": "integer"
    },
    "artisan_name": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "page_sizes": {
      "$ref": "#/definitions/MockPageSizesSchema"
    },
    "upload_policy": {
      "$ref": "#/definitions/MockUploadPolicySchema"
    },
    "hls_url": {
      "type": "string"
    },
    "upload_url": {
      "type": "string"
    },
    "log_events": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/MockLogEventSchema"
      }
    },
    "videos": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MockVideoSchema"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MockProductSchema"
      }
    }
  },
  "required": [
    "latency_ms",
    "chunk_delay_ms",
    "processing_seconds",
    "artisan_name",
    "currency",
    "page_sizes",
    "upload_policy",
    "hls_url",
    "upload_url",
    "log_events",
    "videos",
    "products"
  ],
  "definitions": {
    "MockLogEventSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "group",
        "level",
        "message"
      ]
    },
    "MockPageSizesSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "products": {
          "type": "integer"
        },
        "logs": {
          "type": "integer"
        }
      },
      "required": [
        "products",
        "logs"
      ]
    },
    "MockProductSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "artisan": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        },
        "mine": {
          "type": "boolean",
          "default": false
        },
        "created_at": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "artisan",
        "price",
        "tags",
        "status",
        "created_at",
        "description"
      ]
    },
    "MockUploadPolicySchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_duration_seconds": {
          "type": "integer"
        },
        "allowed_mime_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chunk_size_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "max_duration_seconds",
        "allowed_mime_types",
        "chunk_size_bytes"
      ]
    },
    "MockVideoSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer"
        },
        "mime_type": {
          "type": "string"
        },
        "seconds": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "size_bytes",
        "mime_type",
        "seconds"
      ]
    }
  }
}
