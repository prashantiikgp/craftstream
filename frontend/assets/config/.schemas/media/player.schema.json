    "WebVideoSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_fit": {
          "type": "string"
        },
        "plays_inline": {
          "type": "boolean"
        },
        "controls": {
          "type": "boolean"
        },
        "preload": {
          "type": "string"
        }
      },
      "required": [
        "object_fit",
        "plays_inline",
        "controls",
        "preload"
      ]
    }
  }
}
