      "type": "boolean"
    },
    "initial_bandwidth_bps": {
      "type": "integer"
    },
    "min_buffer_to_start_seconds": {
      "type": "number"
    },
    "max_buffer_seconds": {
      "type": "number"
    },
    "upswitch_safety_factor": {
      "type": "number"
    },
    "native_upswitch_when_buffered_seconds": {
      "type": "number"
    },
    "native_upswitch_within_seconds": {
      "type": "number"
    },
    "poster": {
      "$ref": "#/definitions/PosterSchema"
    },
    "autoplay_in_grids": {
      "type": "boolean"
    },
    "autoplay_on_product_page": {
      "type": "boolean"
    },
    "sample_stream_url": {
      "type": "string"
    },
    "lowest_rung_budget_kbps": {
      "type": "integer"
    },
    "master_fetch_timeout_seconds": {
      "type": "number"
    },
    "hls_mime_type": {
      "type": "string"
    },
    "web_video": {
      "$ref": "#/definitions/WebVideoSchema"
    },
    "media_error_recoveries": {
      "type": "integer"
    }
  },
  "required": [
    "start_on_lowest_rung",
    "initial_bandwidth_bps",
    "min_buffer_to_start_seconds",
    "max_buffer_seconds",
    "upswitch_safety_factor",
    "native_upswitch_when_buffered_seconds",
    "native_upswitch_within_seconds",
    "poster",
    "autoplay_in_grids",
    "autoplay_on_product_page",
    "sample_stream_url",
    "lowest_rung_budget_kbps",
    "master_fetch_timeout_seconds",
    "hls_mime_type",
    "web_video",
    "media_error_recoveries"
