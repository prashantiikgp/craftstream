{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (local, in-memory)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "env": { "CRAFTSTREAM_MODE": "local" },
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Flutter: Chrome",
      "type": "dart",
      "request": "launch",
      "cwd": "frontend",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--dart-define=API_HOST=http://localhost:8000"]
    },
    {
      "name": "Flutter: Android (emulator)",
      "type": "dart",
      "request": "launch",
      "cwd": "frontend",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_HOST=http://10.0.2.2:8000"]
    }
  ],
  "compounds": [
    { "name": "API + Chrome", "configurations": ["API (local, in-memory)", "Flutter: Chrome"] }
  ]
}
